{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miku-agent.invalid/schemas/release-manifest.schema.json",
  "title": "Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["product_version", "repository_commit", "release_date", "phase", "component_versions", "schema_version", "accepted_adrs", "document_hashes", "validation_report", "known_risks", "next_version"],
  "properties": {
    "product_version": {"const": "0.0.0"},
    "repository_commit": {"anyOf": [{"const": "pending-finalization"}, {"type": "string", "pattern": "^[0-9a-f]{40}$"}]},
    "release_date": {"type": "string", "format": "date"},
    "phase": {"const": "product-definition-lock"},
    "component_versions": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "accepted_adrs": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"type": "string", "pattern": "^ADR-[0-9]{4}$"}},
    "document_hashes": {"type": "object", "minProperties": 5, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "validation_report": {"const": "reports/v0.0.0-validation.md"},
    "known_risks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "next_version": {"const": "0.1.0"}
  }
}
