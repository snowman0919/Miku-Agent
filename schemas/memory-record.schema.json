{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miku-agent.invalid/schemas/memory-record.schema.json",
  "title": "Memory Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["memory_id", "namespace_id", "user_id", "character_id", "type", "subject", "predicate", "value", "confidence", "importance", "status", "evidence", "created_by", "created_at", "updated_at", "revision", "supersedes"],
  "properties": {
    "memory_id": {"type": "string", "format": "uuid"},
    "namespace_id": {"type": "string", "pattern": "^usr_[A-Za-z0-9]+:char_[a-z0-9_-]+$"},
    "user_id": {"type": "string", "format": "uuid"},
    "character_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,31}$"},
    "type": {"enum": ["explicit", "episodic", "project", "inferred", "personalization"]},
    "subject": {"type": "string", "minLength": 1},
    "predicate": {"type": "string", "minLength": 1},
    "value": {},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "importance": {"type": "number", "minimum": 0, "maximum": 1},
    "status": {"enum": ["candidate", "active", "stable", "superseded", "rejected"]},
    "evidence": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "kind", "reference"], "properties": {"evidence_id": {"type": "string", "format": "uuid"}, "kind": {"enum": ["user_statement", "user_correction", "tool_observation", "repeated_observation", "session_event"]}, "reference": {"type": "string", "minLength": 1}}}},
    "created_by": {"enum": ["user", "model", "tool", "system"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "revision": {"type": "integer", "minimum": 1},
    "supersedes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uuid"}},
    "observation_count": {"type": "integer", "minimum": 1},
    "first_seen": {"type": "string", "format": "date-time"},
    "last_seen": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "inferred"}}, "required": ["type"]}, "then": {"required": ["observation_count", "first_seen", "last_seen"], "properties": {"evidence": {"minItems": 1}}}},
    {"if": {"properties": {"status": {"const": "stable"}}, "required": ["status"]}, "then": {"properties": {"evidence": {"minItems": 1}}}}
  ]
}
