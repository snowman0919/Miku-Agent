{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://miku-agent.invalid/schemas/dataset/rights-record.schema.json","title":"Rights Record","type":"object","additionalProperties":false,"required":["rights_id","source_id","status","evidence_type","evidence_ref","allowed_use","training_allowed","reviewer","actor_type","created_at"],"properties":{"rights_id":{"type":"string","format":"uuid"},"source_id":{"type":"string","format":"uuid"},"status":{"enum":["owned","licensed","permitted","unknown","restricted","rejected"]},"evidence_type":{"type":"string","minLength":1},"evidence_ref":{"type":"string"},"evidence_sha256":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},"allowed_use":{"type":"string"},"training_allowed":{"type":"boolean"},"reviewer":{"type":"string","minLength":1},"actor_type":{"enum":["user","user-delegated","rights-reviewer","agent"]},"created_at":{"type":"integer","minimum":0}},"allOf":[{"if":{"properties":{"status":{"enum":["owned","licensed","permitted"]}},"required":["status"]},"then":{"properties":{"evidence_ref":{"minLength":1}}}}]}
