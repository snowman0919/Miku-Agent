{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miku-agent.invalid/schemas/gpu-worker/output-manifest.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["protocol_version", "job_id", "outputs"],
  "properties": {"protocol_version": {"const": 1}, "job_id": {"type": "string", "minLength": 1}, "outputs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size_bytes", "media_type", "logical_role", "sample_rate", "duration_seconds"], "properties": {"path": {"type": "string", "pattern": "^outputs/(?!.*\\.\\.).+$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "size_bytes": {"type": "integer", "minimum": 0}, "media_type": {"type": "string", "minLength": 1}, "logical_role": {"type": "string", "minLength": 1}, "sample_rate": {"type": ["integer", "null"], "minimum": 1}, "duration_seconds": {"type": ["number", "null"], "minimum": 0}}}}}
}
