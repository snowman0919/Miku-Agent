{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miku-agent.invalid/schemas/product-lock.schema.json",
  "title": "V0.0.0 Product Lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "phase", "repository", "execution", "character", "model", "auth", "memory", "transport", "clients", "codex", "scheduler", "animation", "data"],
  "properties": {
    "version": {"const": "0.0.0"},
    "phase": {"const": "product-definition-lock"},
    "repository": {"type": "object", "additionalProperties": false, "required": ["visibility", "public_distribution", "data_in_git", "weights_in_git", "media_assets_in_git", "secrets_in_git"], "properties": {"visibility": {"const": "private"}, "public_distribution": {"const": false}, "data_in_git": {"const": false}, "weights_in_git": {"const": false}, "media_assets_in_git": {"const": false}, "secrets_in_git": {"const": false}}},
    "execution": {"type": "object", "additionalProperties": false, "required": ["local_only", "server_allowed_from", "production_deployment_allowed"], "properties": {"local_only": {"const": true}, "server_allowed_from": {"const": "0.1.0"}, "production_deployment_allowed": {"const": false}}},
    "character": {"type": "object", "additionalProperties": false, "required": ["initial_character_id", "strategy", "relationship", "future_profile_fields"], "properties": {"initial_character_id": {"const": "miku"}, "strategy": {"const": "character_specific_finetuning"}, "relationship": {"type": "array", "contains": {"const": "best_friend"}}, "future_profile_fields": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "string"}}}},
    "model": {"type": "object", "additionalProperties": false, "required": ["base_family", "base_size", "stt_languages", "llm_full_tuning_allowed_after_lora_validation", "tts_engine", "voice_mode", "codec_frozen", "training_branches"], "properties": {"base_family": {"const": "nvidia-nemotron-voicechat"}, "base_size": {"const": "11b"}, "stt_languages": {"type": "array", "allOf": [{"contains": {"const": "ko"}}, {"contains": {"const": "en"}}]}, "llm_full_tuning_allowed_after_lora_validation": {"const": true}, "tts_engine": {"const": "integrated"}, "voice_mode": {"const": "static_speaker_adaptation"}, "codec_frozen": {"const": true}, "training_branches": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string"}}}},
    "auth": {"type": "object", "additionalProperties": false, "required": ["provider", "signup_gate", "runtime_gate", "default_policy", "identifier_preference", "user_primary_key", "account_states", "roles"], "properties": {"provider": {"const": "clerk"}, "signup_gate": {"const": "clerk_allowlist"}, "runtime_gate": {"const": "backend_access_grant"}, "default_policy": {"const": "deny"}, "identifier_preference": {"const": "exact_email"}, "user_primary_key": {"const": "internal_uuid"}, "account_states": {"type": "array", "const": ["pending", "active", "suspended", "revoked"]}, "roles": {"type": "array", "const": ["owner", "tester"]}}},
    "memory": {"type": "object", "additionalProperties": false, "required": ["namespace", "inferred_memory", "versioned_history", "user_control", "silent_overwrite"], "properties": {"namespace": {"const": "user_and_character"}, "inferred_memory": {"const": "enabled"}, "versioned_history": {"const": true}, "user_control": {"const": "required"}, "silent_overwrite": {"const": false}}},
    "transport": {"type": "object", "additionalProperties": false, "required": ["audio", "audio_path", "events", "events_path", "external_api", "internal_rpc", "webrtc"], "properties": {"audio": {"const": "binary_websocket"}, "audio_path": {"const": "/ws/audio"}, "events": {"const": "websocket"}, "events_path": {"const": "/ws/events"}, "external_api": {"const": "https"}, "internal_rpc": {"const": "grpc"}, "webrtc": {"const": false}}},
    "clients": {"type": "object", "additionalProperties": false, "required": ["mobile", "desktop", "ui_code_shared", "local_model_size", "local_model_multimodal", "server_precedence"], "properties": {"mobile": {"const": "flutter"}, "desktop": {"const": "unity"}, "ui_code_shared": {"const": false}, "local_model_size": {"const": "2b_to_4b"}, "local_model_multimodal": {"const": true}, "server_precedence": {"const": true}}},
    "codex": {"type": "object", "additionalProperties": false, "required": ["runtime", "internet", "container_root", "privileged", "host_docker_socket", "default_lifetime_days", "local_pc_access_requires_approval"], "properties": {"runtime": {"const": "docker"}, "internet": {"const": "allowed"}, "container_root": {"const": "allowed"}, "privileged": {"const": false}, "host_docker_socket": {"const": false}, "default_lifetime_days": {"const": 30}, "local_pc_access_requires_approval": {"const": true}}},
    "scheduler": {"type": "object", "additionalProperties": false, "required": ["server_side", "delivery", "permission_levels"], "properties": {"server_side": {"const": true}, "delivery": {"const": "push"}, "permission_levels": {"type": "array", "const": ["notify-only", "read-only", "tool-use", "workspace-write", "external-write"]}}},
    "animation": {"type": "object", "additionalProperties": false, "required": ["controller", "direct_llm_bone_transforms"], "properties": {"controller": {"const": "hierarchical_hybrid"}, "direct_llm_bone_transforms": {"const": false}}},
    "data": {"type": "object", "additionalProperties": false, "required": ["minimum_effective_speech_hours", "speech_singing_separated", "unknown_rights_accepted"], "properties": {"minimum_effective_speech_hours": {"const": 30}, "speech_singing_separated": {"const": true}, "unknown_rights_accepted": {"const": false}}}
  }
}
