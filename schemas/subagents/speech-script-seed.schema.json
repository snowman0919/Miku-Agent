{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miku-agent.invalid/schemas/subagents/speech-script-seed.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["category", "templates"],
  "properties": {
    "category": {"type": "string", "minLength": 1},
    "templates": {
      "type": "array", "minItems": 8, "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["raw_text", "scenario", "coverage_targets"],
        "properties": {
          "raw_text": {"type": "string", "minLength": 4},
          "scenario": {"type": "string", "minLength": 1},
          "coverage_targets": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
